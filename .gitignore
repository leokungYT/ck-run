# Python cache
__pycache__/
*.py[cod]

# Virtual env (torch/easyocr ~2GB — DO NOT commit)
.venv/

# find OCR debug crops
img/find/_debug/

# Runtime / generated state
shared_stats.json
_tmp_*/

# per-device logs (อาจมี member ID / ชื่อบัญชี — ไม่ publish)
logs/

# web-item stats — ฝัง member ID ไว้ ไม่ publish (เว็บสถิติดูในเครื่องอย่างเดียว)
web-item/stats.json
web-item/index.html

# Account data — DO NOT publish (game saves contain member IDs)
*.zip
backup/*.xml
push-file-ck/backup/*
push-file-ck/input-id/*

# input-id: ผู้ใช้เลือกอัพขึ้น GitHub (public) — override *.zip เฉพาะโฟลเดอร์นี้
!input-id/
!input-id/**

# keep empty folders in the repo
!**/.gitkeep
